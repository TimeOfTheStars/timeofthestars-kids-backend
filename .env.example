# Postgres (используется и контейнером БД, и api для построения DATABASE_URL в docker-compose)
# В проде ОБЯЗАТЕЛЬНО сгенерируйте сильный пароль:
#   openssl rand -hex 16
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_to_a_strong_random_password
POSTGRES_DB=app

# Для локального запуска api ВНЕ docker-compose можно указать DATABASE_URL напрямую.
# В docker-compose он формируется автоматически из POSTGRES_USER/PASSWORD/DB и хоста "db".
# DATABASE_URL=postgresql+asyncpg://app:change_me_to_a_strong_random_password@localhost:5432/app

# VK: токен сообщества (group token) для отправки уведомлений (messages.send)
VK_TOKEN=your_vk_access_token

# VK: токен для чтения обсуждений (board.getComments). Подходит:
#  - сервисный токен приложения VK (vk.com/dev → Мои приложения → Сервисный ключ доступа), либо
#  - user access token (standalone-приложение).
# Group/community токен сюда не подойдёт — VK вернёт ошибку 27.
# Если не задан — будет попытка использовать VK_TOKEN.
VK_READ_TOKEN=your_vk_service_or_user_token

# JWT для кабинета (минимум 32 символа)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Первый админ при пустой таблице admin_users (потом удалите из .env в проде)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change_me_strong_password
# Опционально: сразу привязать VK user_id к первому админу
# ADMIN_BOOTSTRAP_VK_USER_ID=123456789

# Источник отзывов: VK обсуждение (topic) в сообществе
VK_REVIEWS_GROUP_ID=125696800
VK_REVIEWS_TOPIC_ID=56616420

# Автосинк отзывов и новостей из VK. 0 — выключить, цикл фоновой задачи в приложении.
VK_SYNC_INTERVAL_MINUTES=15
VK_SYNC_INITIAL_DELAY_SECONDS=30

# Базовый URL бэкенда. Если задан — относительные ссылки на /static/... в публичных
# ответах превращаются в абсолютные (https://.../static/teams/<...>.png).
PUBLIC_BASE_URL=https://api.timeofthestars-kids.ru

# Опционально
VK_API_VERSION=5.199
HTTP_TIMEOUT_SECONDS=15
VK_RETRY_ATTEMPTS=3
VK_RETRY_BACKOFF_SECONDS=0.5
SQLALCHEMY_ECHO=false
LOG_LEVEL=INFO
JWT_EXPIRE_MINUTES=1440

# Тег образа приложения. Ставится автодеплоем (= SHA коммита) в .env на сервере.
# Локально можно не задавать — compose возьмёт latest и при необходимости соберёт образ сам.
# APP_TAG=latest
